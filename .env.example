# sim  — the frontend runs on the prototype's generated data (P0 default)
# live — throws "not implemented" until the ingest layer lands in P1
DATA_SOURCE=sim

# Absolute origin for canonical and Open Graph URLs. Defaults to the
# production domain; override on preview deploys.
NEXT_PUBLIC_SITE_URL=https://taredata.com

# Fixes the SimProvider's PRNG so server and client render identical numbers.
# Change it to reshuffle the simulated day; leave it alone to keep screenshots
# and review builds reproducible.
SIM_SEED=1296520521

# Where waitlist signups are forwarded. Any endpoint that accepts a JSON POST.
# Unset means /api/waitlist answers 501 and the form says so, rather than
# accepting an address into nowhere.
# WAITLIST_WEBHOOK_URL=

# Shown in the footer and the waitlist block. Unset links are not rendered —
# a dead social link costs more than a missing one.
# NEXT_PUBLIC_X_URL=
# NEXT_PUBLIC_TELEGRAM_URL=
# NEXT_PUBLIC_GITHUB_URL=
# NEXT_PUBLIC_CONTACT_EMAIL=

# Set this and the CA chip stops reading "coming soon" and becomes copyable.
# NEXT_PUBLIC_CONTRACT_ADDRESS=

# ---------------------------------------------------------------------------
# Alerts (P5). Nothing is delivered while DATA_SOURCE=sim — see below.
# ---------------------------------------------------------------------------
# Shared secret the ingest worker presents to POST /api/alerts/dispatch.
# Unset closes the route entirely.
# ALERTS_DISPATCH_SECRET=

# TELEGRAM_BOT_TOKEN=            # from @BotFather
# TELEGRAM_CHAT_ID=              # -100... for a channel; add the bot as admin

# X / Twitter, OAuth 1.0a user context, with Read and Write permission.
# Free tier is 500 posts a month, which is why the X thresholds below start an
# order of magnitude above the Telegram ones.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# Thresholds in USD. Defaults shown; raise the X ones before the post budget
# becomes the thing that decides what gets published.
# ALERT_TG_ARRIVAL_USD=5000000
# ALERT_TG_REEXPORT_USD=3000000
# ALERT_TG_IDLE_USD=2000000
# ALERT_TG_FIRST_SEEN_USD=1000000
# ALERT_X_ARRIVAL_USD=25000000
# ALERT_X_REEXPORT_USD=20000000
# ALERT_X_IDLE_USD=25000000
# ALERT_X_FIRST_SEEN_USD=10000000
# ALERT_TG_COOLDOWN_S=20
# ALERT_X_COOLDOWN_S=1800

# Alerts are refused outright while the figures are simulated. Set this only to
# test into a private channel — every message is then prefixed [SIMULATED] at
# format time, where no transport can drop it.
# ALERTS_ALLOW_SIMULATED=false

# ---------------------------------------------------------------------------
# P1 onwards. Nothing below is read yet. docs/P1-CREDENTIALS.md explains what
# each one costs, what it blocks, and the order to acquire them in.
# ---------------------------------------------------------------------------

# Solana ingest. The gRPC stream is not on the free tier and is not optional —
# §2 fixes the choice because RPC polling cannot meet the under-10s promise.
# The RPC url is separate and does real work: gap repair after a stream
# restart, and pulling each settlement's full transaction.
# HELIUS_API_KEY=
# HELIUS_GRPC_ENDPOINT=            # laserstream-mainnet-<region>.helius-rpc.com
# HELIUS_RPC_URL=

# Prices. amount_native → amount_usd needs the price AT SETTLEMENT, not spot,
# or every historical figure rewrites itself as the market moves. Pyth covers
# the majors on-chain and for free; Birdeye covers the Solana long tail.
# BIRDEYE_API_KEY=
# COINGECKO_API_KEY=               # optional, reconciliation only

# Origin chains (P2). One key across all seven EVM chains — Ethereum, Base,
# Arbitrum, Optimism, Polygon, BNB Chain, Avalanche. The bridges' own APIs are
# the cheaper start; this is what replaces them once volume justifies owning
# the read.
# ALCHEMY_API_KEY=

# Entity labels (§3.2). Dune is the seed set for exchange hot wallets. Any
# vendor label that names a firm is dropped at the ingest boundary — venue
# labels only, no exceptions, §1.
# DUNE_API_KEY=

# Storage.
# CLICKHOUSE_URL=
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
# POSTGRES_URL=
# REDIS_URL=
