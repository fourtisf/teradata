# sim  — the frontend runs on the prototype's generated data (P0 default)
# live — throws "not implemented" until the ingest layer lands in P1
DATA_SOURCE=sim

# Absolute origin for canonical and Open Graph URLs. Defaults to the
# production domain; override on preview deploys.
NEXT_PUBLIC_SITE_URL=https://taredata.com

# Fixes the SimProvider's PRNG so server and client render identical numbers.
# Change it to reshuffle the simulated day; leave it alone to keep screenshots
# and review builds reproducible.
SIM_SEED=1296520521

# Where waitlist signups are forwarded. Any endpoint that accepts a JSON POST.
# Unset means /api/waitlist answers 501 and the form says so, rather than
# accepting an address into nowhere.
# WAITLIST_WEBHOOK_URL=

# Shown in the footer and the waitlist block. Unset links are not rendered —
# a dead social link costs more than a missing one.
# NEXT_PUBLIC_X_URL=
# NEXT_PUBLIC_TELEGRAM_URL=
# NEXT_PUBLIC_GITHUB_URL=
# NEXT_PUBLIC_CONTACT_EMAIL=

# Set this and the CA chip stops reading "coming soon" and becomes copyable.
# NEXT_PUBLIC_CONTRACT_ADDRESS=

# ---------------------------------------------------------------------------
# Alerts (P5). Nothing is delivered while DATA_SOURCE=sim — see below.
# ---------------------------------------------------------------------------
# Shared secret the ingest worker presents to POST /api/alerts/dispatch.
# Unset closes the route entirely.
# ALERTS_DISPATCH_SECRET=

# TELEGRAM_BOT_TOKEN=            # from @BotFather
# TELEGRAM_CHAT_ID=              # -100... for a channel; add the bot as admin

# The value Telegram presents on every webhook delivery, so the bot can answer
# /today, /week and /status. Unset closes the route entirely — an open endpoint
# that makes the account speak is not a thing to leave lying around.
#   openssl rand -hex 32
#   npm run telegram:webhook -- --set
# TELEGRAM_WEBHOOK_SECRET=

# X / Twitter, OAuth 1.0a user context, with Read and Write permission.
# Free tier is 500 posts a month, which is why the X thresholds below start an
# order of magnitude above the Telegram ones.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# Thresholds in USD. Defaults shown; raise the X ones before the post budget
# becomes the thing that decides what gets published.
# ALERT_TG_ARRIVAL_USD=5000000
# ALERT_TG_REEXPORT_USD=3000000
# ALERT_TG_IDLE_USD=2000000
# ALERT_TG_FIRST_SEEN_USD=1000000
# ALERT_X_ARRIVAL_USD=25000000
# ALERT_X_REEXPORT_USD=20000000
# ALERT_X_IDLE_USD=25000000
# ALERT_X_FIRST_SEEN_USD=10000000
# ALERT_TG_COOLDOWN_S=20
# ALERT_X_COOLDOWN_S=1800

# X's monthly allowance, and how it is divided. Enforced, not just documented:
# the poster below publishes unattended, and an allowance spent by the 20th
# means the feed is silent for eleven days. Scheduled posts may spend down to
# the safety margin; alerts stop a reserve short of it, so the recaps still
# have room. Free tier is 500 — raise it only if the plan actually changed.
# X_MONTHLY_BUDGET=500
# ALERT_X_SCHEDULED_RESERVE=60
# ALERT_X_SAFETY_MARGIN=20

# Alerts are refused outright while the figures are simulated. Set this only to
# test into a private channel — every message is then prefixed [SIMULATED] at
# format time, where no transport can drop it. This covers the scheduled poster
# below as well: one switch, both halves.
#
# It does not open X. There is no private tweet, so a test post there is public
# and permanent in the only way that matters. The poster refuses X while the
# figures are simulated unless `--public` is passed on the command line, and
# scripts/alert-test.mts asks for the same flag.
# ALERTS_ALLOW_SIMULATED=false

# ---------------------------------------------------------------------------
# The scheduled poster (P5). `npm run social`, or the tare-social PM2 process.
#
# Alerts are reactive and publish nothing on a quiet day. This is the half that
# posts on a clock: a recap of the most recent day whose 24-hour windows have
# all closed, and a weekly recap of the seven settled days before it.
# ---------------------------------------------------------------------------

# Where the record of what has already been published lives. It has to survive
# a redeploy, so on the VPS it is outside the checkout — ecosystem.config.cjs
# sets this. Unset means ./.tare/social, which is right for development.
# SOCIAL_LEDGER_DIR=/var/lib/tare/social

# Which triggers run, and where they post. Bring the feed up on Telegram first
# if you want to read the copy on a real screen before X sees it.
# SOCIAL_JOBS=daily,weekly
# SOCIAL_CHANNELS=telegram,x

# Minutes past midnight UTC, and the weekday for the weekly (1 = Monday).
# SOCIAL_DAILY_AT_MINUTE=5
# SOCIAL_WEEKLY_AT_MINUTE=20
# SOCIAL_WEEKLY_WEEKDAY=1

# §3.3's watch window. It decides which day is settled, and therefore which day
# the recap is about — §11 lists 24h as an assumption to re-test against real
# volume, and the post date follows whatever this becomes.
# REEXPORT_WINDOW_HOURS=24

# The daily card is fetched from the app's own Open Graph route rather than
# rendered a second time. Point this at wherever the app is listening.
# SOCIAL_CARD_ORIGIN=http://127.0.0.1:3000
# SOCIAL_CARD=true

# How often the worker looks at the clock.
# SOCIAL_TICK_MS=60000

# ---------------------------------------------------------------------------
# P1 onwards. Nothing below is read yet. docs/P1-CREDENTIALS.md explains what
# each one costs, what it blocks, and the order to acquire them in.
# ---------------------------------------------------------------------------

# Solana ingest. The gRPC stream is not on the free tier and is not optional —
# §2 fixes the choice because RPC polling cannot meet the under-10s promise.
# The RPC url is separate and does real work: gap repair after a stream
# restart, and pulling each settlement's full transaction.
# HELIUS_API_KEY=
# HELIUS_GRPC_ENDPOINT=            # laserstream-mainnet-<region>.helius-rpc.com
# HELIUS_RPC_URL=

# Prices. amount_native → amount_usd needs the price AT SETTLEMENT, not spot,
# or every historical figure rewrites itself as the market moves.
#
# CoinGecko's free Demo plan. The keyless public endpoint still answers but is
# throttled hard and without warning, so a worker built on it looks fine in
# testing and drops quotes under load — treat the free key as required.
# Sign up: https://www.coingecko.com/en/developers/dashboard
# COINGECKO_API_KEY=
# COINGECKO_PLAN=demo              # demo | pro

# One /simple/price call covers every asset in src/lib/config/prices.ts, so the
# monthly call count depends on this window alone. 600000 = 4,320 calls/month
# against a 10,000 allowance. Lower it and check the arithmetic first.
# PRICE_CACHE_MS=600000
# PRICE_MAX_STALE_MS=1800000       # refuse to price rather than use an old quote

# Origin chains (P2). One key across all seven EVM chains — Ethereum, Base,
# Arbitrum, Optimism, Polygon, BNB Chain, Avalanche. The bridges' own APIs are
# the cheaper start; this is what replaces them once volume justifies owning
# the read.
# ALCHEMY_API_KEY=

# Entity labels (§3.2). Dune is the seed set for exchange hot wallets. Any
# vendor label that names a firm is dropped at the ingest boundary — venue
# labels only, no exceptions, §1.
# DUNE_API_KEY=

# Storage. POSTGRES_URL is the one that is read today: src/lib/db/ writes
# arrivals into it and LiveProvider.getStatus() reads the indexer's state back
# out. Unset throws rather than defaulting to localhost — a read path that
# quietly answers from an empty database puts a wrong headline on a page.
#
#   createdb tare && psql "$POSTGRES_URL" -f deploy/postgres/schema.sql
# POSTGRES_URL=postgres://user:pass@127.0.0.1:5432/tare
# POSTGRES_POOL_MAX=10

# REDIS_URL=

# The ClickHouse settings are kept for the day volume justifies the column
# store — §11 records why the flow store is Postgres for now.
# CLICKHOUSE_URL=
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
