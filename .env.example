# sim  — the frontend runs on the prototype's generated data (P0 default)
# live — throws "not implemented" until the ingest layer lands in P1
DATA_SOURCE=sim

# Absolute origin for canonical and Open Graph URLs. Defaults to the
# production domain; override on preview deploys.
NEXT_PUBLIC_SITE_URL=https://taredata.com

# Fixes the SimProvider's PRNG so server and client render identical numbers.
# Change it to reshuffle the simulated day; leave it alone to keep screenshots
# and review builds reproducible.
SIM_SEED=1296520521

# Where waitlist signups are forwarded. Any endpoint that accepts a JSON POST.
# Unset means /api/waitlist answers 501 and the form says so, rather than
# accepting an address into nowhere.
# WAITLIST_WEBHOOK_URL=

# Shown in the footer and the waitlist block. Unset links are not rendered —
# a dead social link costs more than a missing one.
# NEXT_PUBLIC_X_URL=
# NEXT_PUBLIC_TELEGRAM_URL=
# NEXT_PUBLIC_GITHUB_URL=
# NEXT_PUBLIC_CONTACT_EMAIL=

# Set this and the CA chip stops reading "coming soon" and becomes copyable.
# NEXT_PUBLIC_CONTRACT_ADDRESS=

# ---------------------------------------------------------------------------
# P1 onwards. Nothing below is read yet.
# ---------------------------------------------------------------------------
# HELIUS_API_KEY=
# HELIUS_GRPC_ENDPOINT=
# CLICKHOUSE_URL=
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
# POSTGRES_URL=
# REDIS_URL=
